# --- Database Connection ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# 本機開發用這個；docker compose 會用下面的 POSTGRES_* 自行組出容器內的 DATABASE_URL 覆蓋它。
DATABASE_URL="postgresql://user:password@localhost:5432/liff_db?schema=public"

# --- Docker Compose 專用（compose 直接讀這三個，缺了整組起不來）---
POSTGRES_USER="liff"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="liff_db"

# --- Cloudflare Tunnel（對外公開用；不用 tunnel 就留空並以 `docker compose up app db` 啟動）---
# Zero Trust 後台 → Networks → Tunnels 建立後取得的 token。
# Public Hostname 指向 http://app:3000
TUNNEL_TOKEN=""

# --- Server Configuration ---
# 注意：docker compose 會強制設成 3000。本機直接跑時這個值要跟 vite.config.ts 的 proxy 目標一致。
PORT=3000

# --- LINE LIFF Configuration ---
# Your LIFF ID from LINE Developers Console
LIFF_ID="YOUR_LIFF_ID"
# Same as LIFF_ID, required by Vite to expose to frontend
VITE_LIFF_ID="YOUR_LIFF_ID"

# Optional: For future OAuth implementation if needed
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=""
# The Basic ID of your bot (e.g., @123abcde), used for "Add Friend" link
VITE_LINE_BOT_ID="@your_bot_id"

# --- Security ---
# A 32-byte hex string used for AES-256 encryption.
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="INSERT_YOUR_64_CHAR_HEX_STRING_HERE"

# JWT Secret for Session Management
# Generate similarly to ENCRYPTION_KEY
JWT_SECRET="INSERT_YOUR_SECURE_JWT_SECRET_HERE"

# --- Internal API protection ---
# 保護 /api/internal/monthly-check（手動觸發月檢查用）。
# 排程觸發已改為同程序內執行，不再有跨程序回呼，所以這只剩手動運維用途。
# 留空 = 不保護（向下相容）；設了值就要在呼叫時帶 X-Internal-Secret header。
INTERNAL_API_SECRET=""
